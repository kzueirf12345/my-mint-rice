[desktop/background/slideshow]
delay=15
image-source='xml:///usr/share/cinnamon-background-properties/linuxmint.xml'

[desktop/input-sources]
sources=[('xkb', 'us'), ('xkb', 'ru')]

[desktop/interface]
cursor-blink-time=1200
cursor-size=24
cursor-theme='catppuccin-mocha-pink-cursors'
gtk-theme='Catppuccin-Pink-Dark-B'
gtk-theme-backup='Mint-Y-Dark-Pink'
